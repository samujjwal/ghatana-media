  "vocabularyComparisons": {
    "uploadSessionStates": {
      "typescript": [
        "CREATED",
        "UPLOADING",
        "VERIFYING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "EXPIRED"
      ],
      "java": [
        "OPEN",
        "FINALIZING",
        "COMPLETED",
        "ABORTED",
        "EXPIRED"
      ],
      "verdict": "distinct-intent-models-with-separate-runtime-projection",
      "divergence": "DP-UPLOAD-STATES",
      "runtimeProjection": "runtimeProjectionContracts.uploadStatus"
    },
    "streamStates": {
      "typescript": "MediaRuntimeStreamStateSchema models the canonical SDK/runtime six-state vocabulary; no unrelated legacy StreamSessionSchema",
      "java": [
        "OPEN",
        "CONNECTED",
        "DEGRADED",
        "DRAINING",
        "CLOSED",
        "FAILED"
      ],
      "verdict": "canonical-runtime-parity-established-in-schema; legacy-stream-session-model-not-defined",
      "divergence": "DP-STREAM-STATES",
      "runtimeProjection": "runtimeProjectionContracts.streamState"
    }
  },
  "knownDivergences": [
    {
      "id": "DP-SHA256-CASE",
      "fields": "checksumSha256 letter case",
      "typescript": "rejects uppercase hex (wire-canonical)",
      "java": "accepts and normalizes to lowercase in requireSha256",
      "reconciliation": "acceptable at an explicit normalization boundary; wire producers must emit lowercase so observations are byte-identical across languages"
    },
    {
      "id": "DP-IDENT-MAXLENGTH",
      "fields": "identifier max length",
      "typescript": "rejects > 256 chars (IdentifierSchema.max(256))",
      "java": "non-blank only; no length ceiling on required()",
      "reconciliation": "either hoist the 256 bound into Java required() callsites that back the same contract, or record the TS projection bound as an intentional stricter projection — owner decision pending"
    },
    {
      "id": "DP-TIME-NUMERATOR-ZERO",
      "fields": "numerator = 0",
      "typescript": "SourcePresentationTime accepts numerator 0 (a zero-tick point is meaningful)",
      "java": "MediaTimebase rejects numerator < 1 (it models a positive rational rate, not a point)",
      "reconciliation": "conceptually different contracts (time point vs timebase rate); divergence is intentional but must stay documented so a zero-point value is never routed into a rate slot"
    },
    {
      "id": "DP-BYTES-SAFE-INT",
      "fields": "byte counts above Number.MAX_SAFE_INTEGER",
      "typescript": "rejects unsafe integers (z.number().int().safe())",
      "java": "long accepts up to 2^63-1",
      "reconciliation": "wire exchange should keep the TS bound as the transport ceiling; Java-side values > MAX_SAFE_INTEGER are never valid on the wire"
    },
    {
      "id": "DP-UPLOAD-STATES",
      "fields": "upload session state vocabulary",
      "typescript": "CREATED/UPLOADING/VERIFYING/COMPLETED/FAILED/CANCELLED/EXPIRED",
      "java": "OPEN/FINALIZING/COMPLETED/ABORTED/EXPIRED",
      "reconciliation": "owner decision: DISTINCT_MODEL_NO_LOSSLESS_STATE_MAPPING. Preserve the legacy seven-state UploadSessionSchema as a non-canonical compatibility view; use the five-state MediaRuntimeUploadStatusSchema exclusively for actual runtime UploadSession.status. Clients must use exact runtime DTO identity/progress and must not infer CREATED/UPLOADING/VERIFYING/FAILED/CANCELLED from OPEN/FINALIZING/ABORTED."
    },
    {
      "id": "DP-STREAM-STATES",
      "fields": "stream session state vocabulary",
      "typescript": "Shared MediaRuntimeStreamStateSchema and existing canonical SDK both model six runtime stream states; a separate legacy StreamSessionSchema is absent",
      "java": "OPEN/CONNECTED/DEGRADED/DRAINING/CLOSED/FAILED",
      "reconciliation": "owner decision: canonical six-state runtime stream enum is shared between Java, TypeScript contracts and SDK alias; no new wire route, invented state, or schema for a different legacy surface."
    }
  ],
  "runtimeProjectionContracts": {
    "uploadStatus": {
      "authority": "MediaRuntimeContracts.UploadStatus; runtime HTTP UploadSession.status",
      "typescript": [
        "OPEN",
        "FINALIZING",
        "COMPLETED",
        "ABORTED",
        "EXPIRED"
      ],
      "java": [
        "OPEN",
        "FINALIZING",
        "COMPLETED",
        "ABORTED",
        "EXPIRED"
      ],
      "relationToLegacyUploadSession": "DISTINCT_MODEL_NO_LOSSLESS_STATE_MAPPING"
    },
    "streamState": {
      "authority": "MediaRuntimeContracts.StreamState; canonical SDK StreamSession.state",
      "typescript": [
        "OPEN",
        "CONNECTED",
        "DEGRADED",
        "DRAINING",
        "CLOSED",
        "FAILED"
      ],
      "java": [
        "OPEN",
        "CONNECTED",
        "DEGRADED",
        "DRAINING",
        "CLOSED",
        "FAILED"
      ],
      "relationToLegacyTypes": "RUNTIME_MODEL_EXPOSED_WITHOUT_LEGACY_STREAM_SESSION"
    }
  }
}
