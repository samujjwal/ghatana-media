        "typescript": "accept",
        "java": "accept"
      },
      {
        "value": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde",
        "typescript": "reject",
        "java": "reject",
        "note": "63 hex chars"
      },
      {
        "value": "0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef",
        "typescript": "reject",
        "java": "accept",
        "note": "Java requireSha256 normalizes to lowercase; TS keeps wire-canonical lowercase only",
        "divergence": "DP-SHA256-CASE"
      },
      {
        "value": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "typescript": "reject",
        "java": "reject",
