{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.pdp0.quality-extension-apply-hardening-implementation-receipt.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptKind", "sourceCandidate", "implementation", "verification", "frozenProducerPinState", "authorityBoundary"],
  "properties": {
    "schemaVersion": {"const": "media.pdp0.quality-extension-apply-hardening-implementation-receipt.v2"},
    "receiptKind": {"const": "NON_AUTHORITATIVE_QUALITY_EXTENSION_APPLY_IMPLEMENTATION_EVIDENCE"},
    "sourceCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256", "freezeManifestRef", "freezeManifestSha256", "candidatePostimages"],
      "properties": {
        "ref": {"const": "docs/implementation/observations/pdp0-semantic-audit-slices/AUD-SPEC-002-quality-extension-source-candidate.v2.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "freezeManifestRef": {"const": "docs/implementation/observations/pdp0-semantic-audit-slices/AUD-SPEC-002-quality-extension-source-candidate-v2-freeze-manifest.v1.json"},
        "freezeManifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidatePostimages": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false, "required": ["adapterRef", "adapterSha256", "testRef", "testSha256", "behavior"],
      "properties": {
        "adapterRef": {"const": "scripts/lib/media-pdp0-quality-extension-source-adoption-v2.mjs"},
        "adapterSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "testRef": {"const": "tests/media-pdp0-quality-extension-source-adoption-v2.test.mjs"},
        "testSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "behavior": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "result", "tests", "failures", "canonicalWrites", "negativeCoverage"],
      "properties": {
        "command": {"const": "node --test tests/media-pdp0-quality-extension-source-adoption-v2.test.mjs tests/media-pdp0-quality-extension-source-candidate-v2.test.mjs"},
        "result": {"const": "PASS"}, "tests": {"type": "integer", "minimum": 1}, "failures": {"const": 0},
        "canonicalWrites": {"const": "NONE"}, "negativeCoverage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "frozenProducerPinState": {
      "type": "object", "additionalProperties": false,
      "required": ["oldFreezeManifestPreserved", "oldProducerPinsClaimedCurrent", "note"],
      "properties": {"oldFreezeManifestPreserved": {"const": true}, "oldProducerPinsClaimedCurrent": {"const": false}, "note": {"type": "string", "minLength": 1}}
    },
    "authorityBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceOwnerDecision", "canonicalApply", "sourceCurrentness", "phaseStatusEffect", "independentAcceptance", "nativeProof", "runtimeAdmission"],
      "properties": {"sourceOwnerDecision": {"const": "NOT_PRESENT_IN_CURRENT_FIXED_SOURCE_CUT"}, "canonicalApply": {"const": "NOT_PERFORMED"}, "sourceCurrentness": {"const": "NOT_CLAIMED"}, "phaseStatusEffect": {"const": "NONE"}, "independentAcceptance": {"const": "NOT_CLAIMED"}, "nativeProof": {"const": "NOT_CLAIMED"}, "runtimeAdmission": {"const": "NOT_ADMITTED"}}
    }
  }
}
