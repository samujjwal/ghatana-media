{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.pdp0.quality-applicability-extension-candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "status",
    "sourceChoiceRef",
    "sourceChoiceSha256",
    "capabilityRef",
    "sourcePins",
    "population",
    "extensionSection",
    "exactTarget",
    "sourceMeaning",
    "authority",
    "effects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "media.pdp0.quality-applicability-extension-candidate.v1"
    },
    "artifactKind": {
      "const": "SOURCE_OWNER_QUALITY_APPLICABILITY_EXTENSION_POSTIMAGE_CANDIDATE"
    },
    "status": {
      "const": "CANDIDATE_ONLY_PENDING_DISTINCT_TECHNICAL_PEER_AND_SOURCE_OWNER_APPLY"
    },
    "sourceChoiceRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceChoiceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilityRef": {
      "const": "media.recipe.specification.compile"
    },
    "sourcePins": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historicalBaseRows",
        "currentExtensionRows",
        "currentRows",
        "futureExtensionRows",
        "totalDefinitionExtensions",
        "totalSourceCapabilityDefinitions",
        "historicalDimensionDispositions",
        "historicalMetricDispositions",
        "currentDimensionDispositions",
        "currentMetricDispositions"
      ],
      "properties": {
        "historicalBaseRows": {
          "const": 462
        },
        "currentExtensionRows": {
          "const": 1
        },
        "currentRows": {
          "const": 463
        },
        "futureExtensionRows": {
          "const": 6
        },
        "totalDefinitionExtensions": {
          "const": 7
        },
        "totalSourceCapabilityDefinitions": {
          "const": 469
        },
        "historicalDimensionDispositions": {
          "const": 2772
        },
        "historicalMetricDispositions": {
          "const": 7392
        },
        "currentDimensionDispositions": {
          "const": 2778
        },
        "currentMetricDispositions": {
          "const": 7408
        }
      }
    },
    "extensionSection": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "historicalBaseRows",
        "currentExtensionRows",
        "currentPopulationRows",
        "futureExtensionRows",
        "totalSourceCapabilityDefinitions",
        "records"
      ],
      "properties": {
        "schemaVersion": {
          "const": "media.pdp0.quality-applicability-extension.v1"
        },
        "status": {
          "const": "SOURCE_DERIVED_DEFINITION_CANDIDATE_PENDING_MEDIA_SOURCE_ADOPTION"
        },
        "historicalBaseRows": {
          "const": 462
        },
        "currentExtensionRows": {
          "const": 1
        },
        "currentPopulationRows": {
          "const": 463
        },
        "futureExtensionRows": {
          "const": 6
        },
        "totalSourceCapabilityDefinitions": {
          "const": 469
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1
        }
      },
      "additionalProperties": true
    },
    "exactTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "preimageSha256",
        "postimageRef",
        "postimageSha256"
      ],
      "properties": {
        "targetRef": {
          "const": ".product-experience/pdp-0-product-truth/quality-policy.yaml"
        },
        "preimageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "postimageRef": {
          "type": "string",
          "minLength": 1
        },
        "postimageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sourceMeaning": {
      "type": "object",
      "required": [
        "dimensions",
        "metricStatusCounts",
        "measurementState",
        "qualificationState",
        "thresholds"
      ],
      "properties": {
        "dimensions": {
          "type": "object"
        },
        "metricStatusCounts": {
          "type": "object",
          "properties": {
            "NOT_APPLICABLE": {
              "const": 16
            }
          }
        },
        "measurementState": {
          "const": "NOT_EVALUATED"
        },
        "qualificationState": {
          "const": "NOT_EVALUATED"
        },
        "thresholds": {
          "const": "NONE_DEFINED_OR_ADDED"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "sourceOwnerDecision": {
          "const": "TECHNICAL_SOURCE_CHOICE_RECORDED; MEDIA_SOURCE_ADOPTION_PENDING"
        },
        "distinctTechnicalPeerReview": {
          "const": "PENDING"
        },
        "independentAcceptance": {
          "const": "NOT_CLAIMED"
        },
        "nativeProof": {
          "const": "NOT_CLAIMED"
        }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "properties": {
        "canonicalSourceWrite": {
          "const": "NOT_PERFORMED"
        },
        "sourceCurrentness": {
          "const": "NOT_CLAIMED"
        },
        "phaseStatus": {
          "const": "UNCHANGED"
        },
        "measurement": {
          "const": "NOT_EVALUATED"
        },
        "qualification": {
          "const": "NOT_EVALUATED"
        },
        "runtimeAdmission": {
          "const": "NOT_ADMITTED"
        }
      },
      "additionalProperties": false
    }
  }
}
