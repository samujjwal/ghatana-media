{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.pdp0.quality-extension-source-candidate-provenance-successor.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "predecessorFreezeManifest", "candidate", "semanticProducerPins", "implementationEvidence", "targetPostimages", "equivalence", "authorityBoundary"],
  "properties": {
    "schemaVersion": {"const": "media.pdp0.quality-extension-source-candidate-provenance-successor.v2"},
    "status": {"const": "METADATA_ONLY_SUCCESSOR_PENDING_ROOT_PROVENANCE_REVIEW"},
    "predecessorFreezeManifest": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"const": "docs/implementation/observations/pdp0-semantic-audit-slices/AUD-SPEC-002-quality-extension-source-candidate-v2-freeze-manifest.v1.json"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256", "schemaRef", "schemaSha256"], "properties": {"ref": {"const": "docs/implementation/observations/pdp0-semantic-audit-slices/AUD-SPEC-002-quality-extension-source-candidate.v2.json"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "schemaRef": {"const": "docs/implementation/observations/pdp0-semantic-audit-slices/AUD-SPEC-002-quality-extension-source-candidate.v2.schema.json"}, "schemaSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "semanticProducerPins": {"type": "object", "additionalProperties": false, "required": ["scripts/lib/media-pdp0-quality-extension-source-candidate-v2.mjs", "scripts/plan-media-pdp0-quality-extension-source-candidate-v2.mjs"], "properties": {"scripts/lib/media-pdp0-quality-extension-source-candidate-v2.mjs": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "scripts/plan-media-pdp0-quality-extension-source-candidate-v2.mjs": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "implementationEvidence": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256", "adapterRef", "adapterSha256", "testRef", "testSha256"], "properties": {"ref": {"const": "docs/implementation/observations/pdp0-semantic-audit-slices/AUD-SPEC-002-quality-extension-apply-hardening-implementation-receipt.v1.json"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "adapterRef": {"const": "scripts/lib/media-pdp0-quality-extension-source-adoption-v2.mjs"}, "adapterSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "testRef": {"const": "tests/media-pdp0-quality-extension-source-adoption-v2.test.mjs"}, "testSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "targetPostimages": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["targetRef", "preimageSha256", "postimageRef", "postimageSha256"], "properties": {"targetRef": {"enum": [".product-experience/decision-log.md", ".product-experience/pdp-0-product-truth/quality-policy.yaml"]}, "preimageSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "postimageRef": {"type": "string", "minLength": 1}, "postimageSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "equivalence": {"type": "object", "additionalProperties": false, "required": ["candidateBytesUnchanged", "candidateSchemaBytesUnchanged", "twoTargetPostimageBytesUnchanged", "meaningChange", "oldFreezeManifestCurrentness", "oldProducerPinsCurrentness"], "properties": {"candidateBytesUnchanged": {"const": true}, "candidateSchemaBytesUnchanged": {"const": true}, "twoTargetPostimageBytesUnchanged": {"const": true}, "meaningChange": {"const": "NONE"}, "oldFreezeManifestCurrentness": {"const": "NOT_CLAIMED"}, "oldProducerPinsCurrentness": {"const": "NOT_CLAIMED"}}},
    "authorityBoundary": {"type": "object", "additionalProperties": false, "required": ["rootProvenanceReview", "canonicalApply", "sourceCurrentness", "phaseStatusEffect", "independentAcceptance", "nativeProof"], "properties": {"rootProvenanceReview": {"const": "PENDING"}, "canonicalApply": {"const": "NOT_PERFORMED"}, "sourceCurrentness": {"const": "NOT_CLAIMED"}, "phaseStatusEffect": {"const": "NONE"}, "independentAcceptance": {"const": "NOT_CLAIMED"}, "nativeProof": {"const": "NOT_CLAIMED"}}}
  }
}
