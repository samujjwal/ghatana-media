{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.pdp0.aud-spec-002-source-amendment-candidate.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "auditId",
    "previousReviewedCandidateRef",
    "previousReviewedCandidateSha256",
    "previousReviewedPostimageSha256",
    "sourceBindings",
    "componentPostimageSha256",
    "candidatePostimageSha256",
    "conditionalOutputCorrection",
    "unresolvedOwnerTrustBranch",
    "exactSourceAmendmentRef",
    "exactTargetPostimages",
    "exactFileTargets",
    "blockers",
    "canonicalApply",
    "effects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "media.pdp0.aud-spec-002-source-amendment-candidate.v3"
    },
    "artifactKind": {
      "const": "NON_CANONICAL_EXACT_SOURCE_AMENDMENT_CANDIDATE"
    },
    "auditId": {
      "const": "AUD-SPEC-002"
    },
    "previousReviewedCandidateRef": {
      "const": "docs/implementation/observations/pdp0-semantic-audit-slices/AUD-SPEC-002-source-amendment-candidate.v2.json"
    },
    "previousReviewedCandidateSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previousReviewedPostimageSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crosswalkSha256",
        "auditSha256",
        "capabilitiesSha256",
        "requirementsSha256",
        "capabilityLeafReviewSha256"
      ],
      "properties": {
        "crosswalkSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "auditSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capabilitiesSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requirementsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capabilityLeafReviewSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "componentPostimageSha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityYaml",
        "requirementsYaml",
        "crosswalkJson",
        "sourceAmendmentJson"
      ],
      "properties": {
        "capabilityYaml": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requirementsYaml": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "crosswalkJson": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceAmendmentJson": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "candidatePostimageSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "conditionalOutputCorrection": {
      "const": "SUPPORTED_MIGRATION_ONLY; ordinary compilation retains its existing required graph/project-plan output; AC-14 emits no migration candidate."
    },
    "unresolvedOwnerTrustBranch": {
      "type": "object",
      "required": [
        "status",
        "outputArtifactType",
        "selector",
        "capabilityRef",
        "exactOwnerCapabilityAdjudicationSelector",
        "observedOwnerCapabilityAdjudicationRecordCount",
        "currentTrustReconstructionRecordCount",
        "noRecordInvented"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "UNRESOLVED_OWNER_CAPABILITY_ADJUDICATION_REQUIRED"
        },
        "outputArtifactType": {
          "const": "reviewable-version-bound-schema-migration-candidate-and-semantic-diff"
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "capabilityRef": {
          "const": "media.recipe.specification.compile"
        },
        "exactOwnerCapabilityAdjudicationSelector": {
          "type": "string",
          "minLength": 1
        },
        "observedOwnerCapabilityAdjudicationRecordCount": {
          "const": 0
        },
        "currentTrustReconstructionRecordCount": {
          "const": 0
        },
        "noRecordInvented": {
          "const": true
        }
      }
    },
    "exactSourceAmendmentRef": {
      "const": "docs/implementation/observations/pdp0-semantic-audit-slices/AUD-SPEC-002-source-amendment-postimage.v3.json"
    },
    "exactTargetPostimages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityYaml",
        "requirementsYaml",
        "crosswalkJson"
      ],
      "properties": {
        "capabilityYaml": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requirementsYaml": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "crosswalkJson": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "exactFileTargets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetRef",
          "preimageSha256",
          "recordId"
        ],
        "properties": {
          "targetRef": {
            "type": "string"
          },
          "preimageSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recordId": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "canonicalApply": {
      "const": "NOT_PERFORMED"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalSourceWrite",
        "sourceStatus",
        "applicability",
        "independentAcceptance",
        "nativeClosure",
        "runtimeAdmission"
      ],
      "properties": {
        "canonicalSourceWrite": {
          "const": "NOT_PERFORMED"
        },
        "sourceStatus": {
          "const": "UNCHANGED"
        },
        "applicability": {
          "const": "UNCHANGED"
        },
        "independentAcceptance": {
          "const": "NOT_CLAIMED"
        },
        "nativeClosure": {
          "const": "NOT_CLAIMED"
        },
        "runtimeAdmission": {
          "const": "NOT_ADMITTED"
        }
      }
    }
  }
}
