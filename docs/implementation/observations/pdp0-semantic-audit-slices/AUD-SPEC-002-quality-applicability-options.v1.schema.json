{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.pdp0.aud-spec-002-quality-applicability-options.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "status",
    "authorIdentity",
    "authorRole",
    "sourcePins",
    "predecessorQualityReview",
    "proposedSubject",
    "options",
    "unresolvedDecisions",
    "boundaries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "media.pdp0.aud-spec-002-quality-applicability-options.v1"
    },
    "artifactKind": {
      "const": "SOURCE_BOUND_OWNER_DECISION_OPTIONS_NOT_APPLICABILITY_DISPOSITION"
    },
    "status": {
      "const": "PENDING_EXPLICIT_ROOT_TECHNICAL_SOURCE_OWNER_CHOICE"
    },
    "authorIdentity": {
      "const": "agent:/root/phase_io"
    },
    "authorRole": {
      "const": "DELEGATED_TECHNICAL_SOURCE_AUTHOR_NOT_EXTERNAL_QUALITY_SPECIALIST"
    },
    "sourcePins": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "predecessorQualityReview": {
      "type": "object",
      "required": [
        "ref",
        "status",
        "currentRows",
        "excludedExtensions",
        "acceptance",
        "measurement",
        "qualification"
      ],
      "properties": {
        "ref": {
          "const": "docs/implementation/verification/pdp-38/p0-quality-current-source-review-pxd225.json"
        },
        "status": {
          "const": "HISTORICAL_CURRENTNESS_REVIEW_FOR_462_ROWS_ONLY"
        },
        "currentRows": {
          "const": 462
        },
        "excludedExtensions": {
          "const": 7
        },
        "acceptance": {
          "const": "NOT_CLAIMED"
        },
        "measurement": {
          "const": "NOT_EVALUATED"
        },
        "qualification": {
          "const": "NOT_EVALUATED"
        }
      },
      "additionalProperties": true
    },
    "proposedSubject": {
      "type": "object",
      "required": [
        "capabilityRef",
        "inputArtifactTypes",
        "outputArtifactTypes",
        "typedMediaSignalInputOrOutputRefs",
        "typedModalities",
        "qualityPolicyPopulation",
        "dimensionCount",
        "metricCount"
      ],
      "properties": {
        "capabilityRef": {
          "const": "media.recipe.specification.compile"
        },
        "inputArtifactTypes": {
          "type": "array"
        },
        "outputArtifactTypes": {
          "type": "array"
        },
        "typedMediaSignalInputOrOutputRefs": {
          "type": "array"
        },
        "typedModalities": {
          "type": "array"
        },
        "qualityPolicyPopulation": {
          "type": "object"
        },
        "dimensionCount": {
          "const": 6
        },
        "metricCount": {
          "const": 16
        }
      },
      "additionalProperties": true
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "optionId",
          "disposition",
          "dimensions",
          "metrics",
          "thresholds",
          "measurementState",
          "qualificationState"
        ],
        "properties": {
          "optionId": {
            "enum": [
              "APPLY_EXISTING_EXACT_TYPED_APPLICABILITY_RULES",
              "RETAIN_ALL_EXTENSION_QUALITY_APPLICABILITY_UNKNOWN"
            ]
          },
          "disposition": {
            "type": "string"
          },
          "dimensions": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "criterionId",
                "status",
                "reason"
              ],
              "properties": {
                "criterionId": {
                  "enum": [
                    "QUALITY-DIM-STRUCTURAL-VALIDITY",
                    "QUALITY-DIM-PERCEPTUAL",
                    "QUALITY-DIM-INTENT-FIDELITY",
                    "QUALITY-DIM-DOMAIN-SCIENTIFIC",
                    "QUALITY-DIM-RIGHTS-SAFETY",
                    "QUALITY-DIM-DELIVERY-COMPATIBILITY"
                  ]
                },
                "status": {
                  "enum": [
                    "APPLICABLE",
                    "NOT_APPLICABLE",
                    "UNKNOWN"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "metrics": {
            "type": "array",
            "minItems": 16,
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": [
                "criterionId",
                "status",
                "reason"
              ],
              "properties": {
                "criterionId": {
                  "enum": [
                    "QUALITY-METRIC-IMAGE-DEFECTS",
                    "QUALITY-METRIC-IMAGE-STRUCTURAL-REFERENCE",
                    "QUALITY-METRIC-IMAGE-IDENTITY",
                    "QUALITY-METRIC-IMAGE-PERCEPTUAL",
                    "QUALITY-METRIC-VIDEO-TEMPORAL-DEFECTS",
                    "QUALITY-METRIC-VIDEO-CONTINUITY",
                    "QUALITY-METRIC-VIDEO-IDENTITY-OBJECT-GEOMETRY",
                    "QUALITY-METRIC-VIDEO-PHYSICAL-PLAUSIBILITY",
                    "QUALITY-METRIC-VIDEO-LIP-AV-SYNC",
                    "QUALITY-METRIC-VIDEO-ENCODING",
                    "QUALITY-METRIC-AUDIO-DEFECTS",
                    "QUALITY-METRIC-AUDIO-SEPARATION-LEAKAGE",
                    "QUALITY-METRIC-AUDIO-SPECTRAL-PHASE",
                    "QUALITY-METRIC-AUDIO-LOUDNESS-TRUE-PEAK",
                    "QUALITY-METRIC-AUDIO-NATURALNESS",
                    "QUALITY-METRIC-AUDIO-SPEAKER-SIMILARITY"
                  ]
                },
                "status": {
                  "enum": [
                    "APPLICABLE",
                    "NOT_APPLICABLE",
                    "UNKNOWN"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "thresholds": {
            "const": "NONE_DEFINED_OR_ADDED"
          },
          "measurementState": {
            "const": "NOT_EVALUATED"
          },
          "qualificationState": {
            "const": "NOT_EVALUATED"
          }
        },
        "additionalProperties": true
      }
    },
    "unresolvedDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "boundaries": {
      "type": "object",
      "required": [
        "qualityReviewPopulationCurrent",
        "candidateCurrentCapabilityPopulation",
        "historicalQualityReviewReusableForExtension",
        "ownerAcceptance",
        "independentAcceptance",
        "measurement",
        "qualification",
        "runtimeAdmission"
      ],
      "properties": {
        "qualityReviewPopulationCurrent": {
          "const": 462
        },
        "candidateCurrentCapabilityPopulation": {
          "const": 463
        },
        "historicalQualityReviewReusableForExtension": {
          "const": false
        },
        "ownerAcceptance": {
          "const": "NOT_CLAIMED"
        },
        "independentAcceptance": {
          "const": "NOT_CLAIMED"
        },
        "measurement": {
          "const": "NOT_EVALUATED"
        },
        "qualification": {
          "const": "NOT_EVALUATED"
        },
        "runtimeAdmission": {
          "const": "NOT_ADMITTED"
        }
      },
      "additionalProperties": true
    }
  }
}
