            "preimageSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "postimageSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetRef",
            "preimageSha256",
            "postimageSha256"
          ],
          "properties": {
            "targetRef": {
              "const": ".product-experience/pdp-0-product-truth/capability-leaf-review.yaml"
            },
            "preimageSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "postimageSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
