{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.pdp0.root-selected-source-integration-r8-operation-profile-registration.v1",
  "title": "R8 source-owner operation-profile registration record",
  "description": "Candidate schema consumed by the existing guarded source-amendment CAS. A registration record is accepted only when it binds the exact operation schema, ledger, source-owner adoption, root adoption, decision-log evidence, and no-apply boundary. This schema is not itself a registration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registrationStatus",
    "profileId",
    "registrationSchemaRef",
    "registrationSchemaSha256",
    "operationSchemaRef",
    "operationSchemaSha256",
    "operationLedgerRef",
    "operationLedgerSha256",
    "sourceOwnerDecisionRef",
    "sourceOwnerDecisionSha256",
    "rootAdoptionDecisionRef",
    "rootAdoptionDecisionSha256",
    "decisionRef",
    "decisionSectionSha256",
    "sourceOwnerIdentity",
    "rootAuthorityIdentity",
    "authorityBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": "media.pdp0.root-selected-source-integration-r8-operation-profile-registration.v1" },
    "registrationStatus": { "const": "REGISTERED_FOR_EXACT_R8_SOURCE_SUCCESSOR_ONLY" },
    "profileId": { "const": "media.pdp0.root-selected-source-integration.r8.source-owner.v1" },
    "registrationSchemaRef": { "const": "docs/implementation/observations/media-pdp0-parent-case-resolution-candidates/media-pdp0-root-selected-source-integration-r8.operation-profile-registration.schema.v1.json" },
    "registrationSchemaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operationSchemaRef": { "type": "string", "minLength": 1 },
    "operationSchemaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operationLedgerRef": { "type": "string", "minLength": 1 },
    "operationLedgerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceOwnerDecisionRef": { "type": "string", "minLength": 1 },
    "sourceOwnerDecisionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rootAdoptionDecisionRef": { "type": "string", "minLength": 1 },
    "rootAdoptionDecisionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decisionRef": { "type": "string", "pattern": "^\\.product-experience/decision-log\\.md#PXD-[0-9]{3}$" },
    "decisionSectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceOwnerIdentity": { "type": "string", "minLength": 1 },
    "rootAuthorityIdentity": { "type": "string", "minLength": 1 },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalApply", "phaseStatusEffect", "independentAcceptance", "nativeClosure"],
      "properties": {
        "canonicalApply": { "const": "NOT_AUTHORIZED_BY_PROFILE_REGISTRATION" },
        "phaseStatusEffect": { "const": "NONE" },
        "independentAcceptance": { "const": "NOT_CLAIMED" },
        "nativeClosure": { "const": "NOT_CLAIMED" }
      }
    }
  }
}
