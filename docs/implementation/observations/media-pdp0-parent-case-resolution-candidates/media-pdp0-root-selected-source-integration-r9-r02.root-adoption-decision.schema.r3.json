{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.pdp0.root-selected-source-integration-r9-r02.root-adoption-decision.r3",
  "title": "Candidate root adoption decision schema for exact R9-R02 source application",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionStatus",
    "candidateRef",
    "candidateSha256",
    "freezeManifestRef",
    "freezeManifestSha256",
    "sourceOwnerDecisionRef",
    "sourceOwnerDecisionSha256",
    "actualHReviewRef",
    "actualHReviewSha256",
    "fullCutHReviewRef",
    "fullCutHReviewSha256",
    "selectedBranch",
    "rootAuthority",
    "decisionRef",
    "decisionSectionSha256",
    "authorityBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "media.pdp0.root-selected-source-integration-r9-r02.root-adoption-decision.v3"
    },
    "decisionStatus": {
      "const": "ADOPT_EXACT_R9_R02_SPLIT_SOURCE_SUCCESSOR"
    },
    "candidateRef": {
      "const": "docs/implementation/observations/media-pdp0-parent-case-resolution-candidates/media-pdp0-root-selected-source-integration-r9-r02.successor-bundle.candidate.v1.json"
    },
    "candidateSha256": {
      "const": "7e9b4643ea2231eda8fdb3eb91e3c3eede96f0a3d658052b09e5bb75c551a6ec"
    },
    "freezeManifestRef": {
      "const": "docs/implementation/observations/media-pdp0-parent-case-resolution-candidates/media-pdp0-root-selected-source-integration-r9-r02.freeze.v1.json"
    },
    "freezeManifestSha256": {
      "const": "a828f8ebe54e9854d9d5dd1d3d22f5b61c636056584713b3977e626db3fbedab"
    },
    "sourceOwnerDecisionRef": {
      "const": "docs/implementation/observations/media-pdp0-parent-case-resolution-candidates/media-pdp0-root-selected-source-integration-r9-r02.source-owner-decision.r2.json"
    },
    "sourceOwnerDecisionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actualHReviewRef": {
      "const": "docs/implementation/observations/media-pdp0-parent-case-resolution-candidates/media-pdp0-root-selected-source-integration-r9-r02.independent-peer.actual-h-r02.json"
    },
    "actualHReviewSha256": {
      "const": "b9c93569b8711030195f6003de7494ee8a359cdba50f2f88b2f55cfb1eecacc2"
    },
    "fullCutHReviewRef": {
      "const": "docs/implementation/observations/media-pdp0-parent-case-resolution-candidates/media-pdp0-root-selected-source-integration-r9-r02.independent-peer.actual-h-r02-full.json"
    },
    "fullCutHReviewSha256": {
      "const": "c215cd3937c401fa5c4252ce86af3bbb25f644aebaa9b584d5c9f45660c19a7c"
    },
    "selectedBranch": {
      "const": "split"
    },
    "rootAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "role"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "ROOT_AUTHORITY"
        }
      }
    },
    "decisionRef": {
      "type": "string",
      "pattern": "^\\.product-experience/decision-log\\.md#PXD-[0-9]{3}$"
    },
    "decisionSectionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalApply",
        "phaseStatusEffect",
        "independentAcceptance",
        "nativeClosure"
      ],
      "properties": {
        "canonicalApply": {
          "const": "NOT_AUTHORIZED_BY_ROOT_ADOPTION_DECISION"
        },
        "phaseStatusEffect": {
          "const": "NONE"
        },
        "independentAcceptance": {
          "const": "NOT_CLAIMED"
        },
        "nativeClosure": {
          "const": "NOT_CLAIMED"
        }
      }
    }
  }
}
