{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.pdp0.current-source-review-record.v1",
  "title": "PDP-0 criterion current-source technical review input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "criterionId", "phaseScope", "reviewer", "scopeRef", "reviewedSources", "criterionVerification", "reviewConclusion", "reviewNotes", "authorityBoundary"],
  "properties": {
    "schemaVersion": {"const": "media.pdp0.current-source-review-record.v1"},
    "criterionId": {"enum": ["P0-01", "P0-02", "P0-03", "P0-04", "P0-05", "P0-06", "P0-07", "P0-08"]},
    "phaseScope": {"const": "PDP-0"},
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "reviewRole", "reviewRecordRef"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "reviewRole": {"const": "DISTINCT_TECHNICAL_REVIEWER"},
        "reviewRecordRef": {"type": "string", "minLength": 1}
      }
    },
    "scopeRef": {"type": "string", "minLength": 1},
    "reviewedSources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceRef", "sha256"],
        "properties": {
          "sourceRef": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "criterionVerification": {
      "type": "object", "additionalProperties": false,
      "required": ["statusRecordRef", "statusRecordSha256", "testReceiptRef", "testReceiptSha256", "testStatus", "testCount", "passedTestCount", "skippedTestCount", "outputSha256"],
      "properties": {
        "statusRecordRef": {"const": "docs/implementation/pdp-0-phase-dev-status.json"},
        "statusRecordSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "testReceiptRef": {"type": "string", "pattern": "^docs/implementation/verification/pdp-38/P0-0[1-8]\\.log$"},
        "testReceiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "testStatus": {"const": "PASS"},
        "testCount": {"type": "integer", "minimum": 1},
        "passedTestCount": {"type": "integer", "minimum": 1},
        "skippedTestCount": {"type": "integer", "minimum": 0},
        "outputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "reviewConclusion": {"const": "NO_MATERIAL_PDP0_SEMANTIC_CHANGE_IDENTIFIED"},
    "reviewNotes": {"type": "string", "minLength": 20, "contentMediaType": "application/json", "contentSchema": {"$ref": "media.pdp0.current-source-review-notes.v1"}, "description": "JSON-serialized structured technical review object validated against review-notes.schema.json."},
    "authorityBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["ownerApproval", "independentAcceptance", "pdp010Acceptance", "phaseStatusEffect"],
      "properties": {
        "ownerApproval": {"const": "NOT_CLAIMED"},
        "independentAcceptance": {"const": "NOT_CLAIMED"},
        "pdp010Acceptance": {"const": "NOT_PERFORMED"},
        "phaseStatusEffect": {"const": "NONE"}
      }
    }
  }
}
