    "com.ghatana.media.provider.aws.",
    "com.ghatana.audiovideo.adapter.ledger"
  ],
  "adapterTypePrefixes": [],
  "ownership": {
    "description": "Every effectively publishable Media Java public type resolves to explicit ownership. Requirement-classified selectors name canonical MEDIA-REQ-* and NFR-* requirement IDs.",
