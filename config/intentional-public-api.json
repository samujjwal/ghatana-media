      {
        "surface": "services/media/runtime-contracts",
        "selector": "type-family:com.ghatana.media.runtime.*",
        "classification": "requirements",
        "freezeDisposition": "SUPPORTED_PUBLIC_CONTRACT",
        "requirementIds": ["MEDIA-REQ-CAP-ARTIFACT", "MEDIA-REQ-CAP-JOB", "MEDIA-REQ-CAP-PROVENANCE", "MEDIA-REQ-CAP-RIGHTS", "MEDIA-REQ-CAP-STREAM"]
      },
