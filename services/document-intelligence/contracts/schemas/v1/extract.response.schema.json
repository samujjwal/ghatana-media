{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghatana.dev/schemas/document-intelligence/v1/extract.response.schema.json",
  "title": "POST /v1/extract response (document-intelligence.v1)",
  "description": "Extraction envelope emitted by extraction providers and validated by validate_provider_output. Exact key set; provider.providerRef and each candidate.provider.providerRef must equal the envelope providerRef. evidence.textSpan offsets are zero-based, end-exclusive UTF-16 code-unit offsets into the referenced Shared line text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "operationId", "providerRef", "candidates", "provider"],
  "properties": {
    "protocolVersion": { "const": "document-intelligence.v1" },
    "operationId": { "$ref": "#/$defs/identifier" },
    "providerRef": { "$ref": "#/$defs/identifier" },
    "candidates": {
      "type": "array",
      "maxItems": 16000,
      "description": "Bounded by the configured max_candidates limit (default 16000).",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "provider": { "$ref": "#/$defs/identity" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
    },
    "modelRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(/[A-Za-z0-9][A-Za-z0-9_.:-]{0,127})?$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerRef", "providerVersion"],
      "dependentRequired": {
        "modelRef": ["modelVersion"],
        "modelVersion": ["modelRef"]
      },
      "properties": {
        "providerRef": { "$ref": "#/$defs/identifier" },
        "providerVersion": { "$ref": "#/$defs/identifier" },
        "modelRef": { "$ref": "#/$defs/modelRef" },
        "modelVersion": { "$ref": "#/$defs/identifier" }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "value", "source", "confidence", "evidence", "provider"],
      "properties": {
        "fieldId": { "$ref": "#/$defs/identifier" },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["TEXT", "IDENTIFIER"] },
            "value": {
              "type": "string",
              "maxLength": 2000000,
              "description": "Bounded by max_text_characters (default 2000000)."
            }
          }
        },
        "source": { "const": "MODEL" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "description": "Bounded by the configured max_evidence limit (default 32).",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "provider": { "$ref": "#/$defs/identity" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageNumber"],
      "properties": {
        "pageNumber": { "type": "integer", "minimum": 1 },
        "blockId": { "type": "string" },
        "lineId": { "type": "string" },
        "boundingRegion": { "$ref": "#/$defs/box" },
        "textSpan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "description": "Zero-based end-exclusive UTF-16 code-unit offsets; start >= 0, end >= start, end <= max_text_characters.",
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
