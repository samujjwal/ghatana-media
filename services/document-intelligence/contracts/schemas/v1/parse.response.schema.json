{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghatana.dev/schemas/document-intelligence/v1/parse.response.schema.json",
  "title": "POST /v1/parse response (document-intelligence.v1)",
  "description": "Parsed-document envelope emitted by parse providers and validated by validate_provider_output. providerProvenance.providerRef must equal the envelope providerRef. quality.warnings is an open string list that may carry declared extension tokens (see contracts/protocol-extensions.v1.md). textSpan/boundingRegion geometry: boxes are normalized [0,1] rectangles with x+width<=1 and y+height<=1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "operationId", "providerRef", "pages", "providerProvenance", "quality"],
  "properties": {
    "protocolVersion": { "const": "document-intelligence.v1" },
    "operationId": { "$ref": "#/$defs/identifier" },
    "providerRef": { "$ref": "#/$defs/identifier" },
    "pages": {
      "type": "array",
      "maxItems": 500,
      "description": "Bounded by the configured max_pages limit (default 500).",
      "items": { "$ref": "#/$defs/page" }
    },
    "providerProvenance": { "$ref": "#/$defs/identity" },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parseConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "languageTag": { "type": "string" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
    },
    "modelRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(/[A-Za-z0-9][A-Za-z0-9_.:-]{0,127})?$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerRef", "providerVersion"],
      "dependentRequired": {
        "modelRef": ["modelVersion"],
        "modelVersion": ["modelRef"]
      },
      "properties": {
        "providerRef": { "$ref": "#/$defs/identifier" },
        "providerVersion": { "$ref": "#/$defs/identifier" },
        "modelRef": { "$ref": "#/$defs/modelRef" },
        "modelVersion": { "$ref": "#/$defs/identifier" }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "description": "Normalized bounding box; all components finite, x/y/width/height >= 0, x+width <= 1, y+height <= 1.",
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageNumber", "blocks", "tables"],
      "properties": {
        "pageNumber": { "type": "integer", "minimum": 1 },
        "blocks": {
          "type": "array",
          "description": "Per-page block count bounded by max_blocks (default 100000).",
          "items": { "$ref": "#/$defs/block" }
        },
        "tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/table" }
        },
        "languageTag": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "boundingRegion", "lines"],
      "properties": {
        "blockId": { "type": "string" },
        "kind": { "type": "string" },
        "boundingRegion": { "$ref": "#/$defs/box" },
        "lines": {
          "type": "array",
          "description": "Per-block line count bounded by max_lines (default 200000).",
          "items": { "$ref": "#/$defs/line" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "languageTag": { "type": "string" }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineId", "text", "boundingRegion"],
      "properties": {
        "lineId": { "type": "string" },
        "text": {
          "type": "string",
          "maxLength": 2000000,
          "description": "Bounded by max_text_characters (default 2000000)."
        },
        "boundingRegion": { "$ref": "#/$defs/box" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "languageTag": { "type": "string" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tableId", "boundingRegion", "rowCount", "columnCount", "cells"],
      "properties": {
        "tableId": { "type": "string" },
        "boundingRegion": { "$ref": "#/$defs/box" },
        "rowCount": { "type": "integer", "minimum": 0 },
        "columnCount": { "type": "integer", "minimum": 0 },
        "headers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/cell" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cellId", "rowIndex", "columnIndex", "text", "boundingRegion"],
      "properties": {
        "cellId": { "type": "string" },
        "rowIndex": { "type": "integer", "minimum": 0 },
        "columnIndex": { "type": "integer", "minimum": 0 },
        "rowSpan": { "type": "integer", "minimum": 1 },
        "columnSpan": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" },
        "boundingRegion": { "$ref": "#/$defs/box" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
