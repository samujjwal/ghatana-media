        "modelManifestFingerprint",
        "providerSemanticsFingerprint",
        "evaluationImplementationFingerprint"
      ],
      "doesNotDependOn": [
        "workerClientFingerprint",
        "nodeVersion",
        "pnpmVersion",
        "hardwareFingerprint",
        "sharedContractSnapshotSha256"
      ]
    },
    "increment3.strictGate": {
      "dependsOn": [
        "manifestFingerprint",
        "corpusFingerprint",
        "acceptanceFingerprint",
