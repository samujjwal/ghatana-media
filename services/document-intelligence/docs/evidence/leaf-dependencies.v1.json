{
  "schemaVersion": "document-intelligence.leaf-dependencies.v1",
  "rule": "REUSE requires every dependency declared by the leaf to be recorded and current, the proof schema to remain compatible, and the recorded result to be PASS. A dependency satisfied only at seal level (bound current by another authoritative artifact) is reported as satisfiedViaSealAuthority, not as missing.",
  "leaves": {
    "increment3.evaluation.*": {
      "dependsOn": [
        "manifestFingerprint",
        "corpusFingerprint",
        "acceptanceFingerprint",
