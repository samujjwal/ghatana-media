        "evaluationImplementationFingerprint",
        "sharedContractLockSha256",
        "sharedContractSnapshotSha256",
        "workerClientFingerprint",
        "testSpecFingerprint",
        "uvLockSha256",
        "pythonVersion",
        "pytestVersion",
        "nodeVersion",
        "pnpmVersion"
      ],
