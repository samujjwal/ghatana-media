        "hardwareFingerprint"
      ]
    },
    "increment3.modelVerification": {
      "dependsOn": [
        "modelManifestFingerprint"
      ],
      "doesNotDependOn": [],
      "note": "NOT_RUN by design; model-authority coverage is carried by increment4a.modelVerification for the sealed set."
    },
    "increment4a.campaign.*": {
      "dependsOn": [
        "materialFingerprint",
        "providerSemanticsFingerprint",
        "evaluationImplementationFingerprint"
      ],
      "doesNotDependOn": [
        "workerClientFingerprint",
        "nodeVersion",
        "pnpmVersion",
        "hardwareFingerprint"
      ],
      "note": "uv.lock and installed dependency identities are covered transitively: environment.yaml is inside materialFingerprint."
    },
    "increment4a.materialLock": {
      "dependsOn": [
        "materialFingerprints",
        "providerSemanticsFingerprint",
