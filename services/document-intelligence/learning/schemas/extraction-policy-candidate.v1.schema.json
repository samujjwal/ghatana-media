{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ghatana://document-intelligence/learning/schemas/extraction-policy-candidate.v1",
  "title": "Extraction Policy Candidate v1",
  "description": "Proposed extraction-policy changes (label mappings, aliases, supplemental fields, confidence policy) derived from reviewed corrections. Does not mutate active GLiNER mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "kind",
    "state",
    "targetProvider",
    "parentAuthority",
    "proposedChanges",
    "provenance",
    "candidateFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "document-intelligence.extraction-policy-candidate.v1" },
    "candidateId": { "type": "string", "minLength": 1 },
    "kind": { "const": "EXTRACTION_POLICY" },
    "state": { "enum": ["CANDIDATE", "EVALUATED", "REJECTED", "APPROVED_FOR_SHADOW", "PROMOTED", "SUPERSEDED"] },
    "targetProvider": { "type": "string", "minLength": 1 },
    "parentAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeAuthorityFingerprint", "policyRef"],
      "properties": {
        "activeAuthorityFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "policyRef": { "type": "string", "minLength": 1 }
      }
    },
    "proposedChanges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labelMappings": { "type": "object", "additionalProperties": { "type": "string" } },
        "fieldAliases": { "type": "object", "additionalProperties": { "type": "string" } },
        "supplementalFields": { "type": "array", "items": { "type": "string" } },
        "confidencePolicy": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedbackEventIds"],
      "properties": {
        "feedbackEventIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "datasetFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "candidateFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
