{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ghatana://document-intelligence/learning/schemas/active-learning-entry.v1",
  "title": "Active Learning Queue Entry v1",
  "description": "A governed review-priority entry. The score ranks human review order; it never auto-labels and never changes product results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entryId",
    "executionId",
    "reasonCodes",
    "scoreComponents",
    "priority",
    "status",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "document-intelligence.active-learning-entry.v1" },
    "entryId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "LOW_CONFIDENCE",
          "TEMPLATE_AMBIGUITY",
          "PROVIDER_DISAGREEMENT",
          "NOVEL_TEMPLATE_DISTANCE",
          "HISTORICALLY_ERROR_PRONE_FIELD"
        ]
      }
    },
    "scoreComponents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lowConfidence": { "type": "number" },
        "ambiguity": { "type": "number" },
        "providerDisagreement": { "type": "number" },
        "novelTemplateDistance": { "type": "number" },
        "errorProneField": { "type": "number" }
      }
    },
    "priority": { "type": "number" },
    "status": { "enum": ["QUEUED", "CLAIMED", "REVIEWED", "WITHDRAWN"] },
    "claimedBy": { "type": "string" },
    "claimedAt": { "type": "string", "format": "date-time" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
