{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ghatana://document-intelligence/learning/schemas/dataset-manifest.v2",
  "title": "Learning Dataset Manifest v2",
  "description": "Immutable manifest for a materialized learning dataset root. v2 adds the tenant-scope declaration (I5-34) and the revocation supersession record (I5-40). A dataset is reproducible iff the same feedback events, policy, and source authority rebuild an identical manifest. Reader note: consumers of dataset manifests must accept schemaVersion v2; manifests written under learning/datasets/out as v2 are verified by the v2-aware increment-6 verifier — the sealed increment-5 verifier only understands dataset-manifest.v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetRevision",
    "createdAt",
    "builder",
    "policy",
    "source",
    "splits",
    "statistics",
    "leakage",
    "tenantScope",
    "datasetFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "document-intelligence.dataset-manifest.v2" },
    "datasetId": { "type": "string", "minLength": 1 },
    "datasetRevision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "tenantScope": {
      "enum": ["TENANT_LOCAL", "MULTI_TENANT_EXPLICITLY_AUTHORIZED", "SYNTHETIC_PUBLIC"],
      "description": "Declared tenancy of every contributing feedback event (I5-34). TENANT_LOCAL is the default: all events belong to one tenant partition. MULTI_TENANT_EXPLICITLY_AUTHORIZED requires scopeAuthorizationRef. SYNTHETIC_PUBLIC marks non-tenant synthetic/public data."
    },
    "scopeAuthorizationRef": {
      "type": "string",
      "minLength": 1,
      "description": "Authorization reference for MULTI_TENANT_EXPLICITLY_AUTHORIZED datasets; required by policy when tenantScope is MULTI_TENANT_EXPLICITLY_AUTHORIZED (enforced by the builder)."
    },
    "tenantRef": {
      "type": "string",
      "minLength": 1,
      "description": "Tenant partition identity for TENANT_LOCAL datasets (derived from the event-root tenant partition or declared via --tenant-ref)."
    },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorRevision", "reason", "revokedEventIds"],
      "description": "Recorded when this revision replaces an earlier revision because feedback events were revoked (I5-40). Prior revisions are never rewritten.",
      "properties": {
        "priorRevision": { "type": "integer", "minimum": 1 },
        "reason": { "enum": ["REVOCATION"] },
        "revokedEventIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementationFingerprint", "version"],
      "properties": {
        "implementationFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetPolicyRef", "eligibilityPolicyRef", "dedupPolicy", "splitPolicy"],
      "properties": {
        "datasetPolicyRef": { "type": "string", "minLength": 1 },
        "eligibilityPolicyRef": { "type": "string", "minLength": 1 },
        "dedupPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "canonicalKeys"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "canonicalKeys": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["sourceContentFingerprint", "fieldSchemaIdentity", "reviewLineage"] }
            }
          }
        },
        "splitPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "strategy", "groupKey", "evalFraction", "seed"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "strategy": { "const": "stable-group-hash" },
            "groupKey": { "enum": ["sourceContentFingerprint", "reviewLineage"] },
            "evalFraction": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "seed": { "type": "integer" }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventRootFingerprint", "acceptedEventIds", "excludedEvents"],
      "properties": {
        "eventRootFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "acceptedEventIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "excludedEvents": {
          "type": "array",
          "description": "Events present in the input root but excluded (ineligible, tombstoned, revoked). Recorded for auditability.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eventId", "reason"],
            "properties": {
              "eventId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "eval"],
      "properties": {
        "train": { "$ref": "#/$defs/split" },
        "eval": { "$ref": "#/$defs/split" }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "documentClasses", "fieldTypes", "providerSources", "reviewOutcomes", "correctionFrequencies"],
      "properties": {
        "languages": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "documentClasses": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "fieldTypes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "providerSources": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "reviewOutcomes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "correctionFrequencies": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "leakage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "status"],
            "properties": {
              "check": { "enum": ["SAME_SOURCE_ACROSS_SPLITS", "REVIEW_LINEAGE_ACROSS_SPLITS", "NEAR_DUPLICATE_SOURCE"] },
              "status": { "enum": ["PASS", "FAIL", "NOT_SUPPORTED"] },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["holdoutId", "selectionAuthority", "eventIds", "memberFingerprint", "selectionFingerprint"],
          "properties": {
            "holdoutId": { "type": "string", "minLength": 1 },
            "selectionAuthority": { "enum": ["explicit-event-set", "stable-group-hash"] },
            "groupKey": { "type": "string" },
            "seed": { "type": "integer" },
            "eventIds": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
            "memberFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "selectionFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "sufficiency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "counts", "minimumSupport", "deficits", "supportFingerprint"],
          "properties": {
            "status": { "enum": ["PASS", "NOT_QUALIFIED"] },
            "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "minimumSupport": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
            "deficits": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["subgroup", "observed", "required"], "properties": { "subgroup": { "type": "string" }, "observed": { "type": "integer", "minimum": 0 }, "required": { "type": "integer", "minimum": 1 } } } },
            "supportFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        }
      }
    },
    "datasetFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 over the canonical manifest excluding datasetFingerprint; also the dataset identity for candidates."
    }
  },
  "$defs": {
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "memberFingerprint"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "memberFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
