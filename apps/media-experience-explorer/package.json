{
  "name": "@ghatana/media-experience-explorer",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "description": "Browser review client for Media first-use, artifact-intake and verification, and transcription and caption simulations",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretypecheck": "pnpm --filter @audio-video/client build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @ghatana/media-experience-simulation build",
    "test": "node --test test/*.test.mjs && vitest run test/dev-artifact-hasher.test.ts test/dev-open-project.test.ts",
    "test:dev-project-timeline:browser": "node test/dev-project-timeline-browser.mjs",
    "test:dev-creative-outputs:browser": "node test/dev-creative-outputs-browser.mjs",
    "test:visual-regression": "node test/run-visual-regression.mjs"
  },
  "dependencies": {
    "@audio-video/client": "workspace:*",
    "@audio-video/ui": "workspace:*",
    "@ghatana/development-traceability": "0.1.0-SNAPSHOT",
    "@ghatana/experience-explorer-contracts": "0.1.0-SNAPSHOT",
    "@ghatana/experience-package": "0.1.0-SNAPSHOT",
    "@ghatana/media-experience-simulation": "workspace:*",
    "@ghatana/product-definition": "0.1.0-SNAPSHOT",
    "@ghatana/product-dev-explorer": "0.1.0-SNAPSHOT",
    "@noble/hashes": "2.4.0",
    "lucide-react": "catalog:shared",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright": "1.63.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
