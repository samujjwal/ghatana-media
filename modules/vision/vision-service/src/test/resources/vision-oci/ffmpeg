#!/bin/bash
set -eu

fail() { printf 'fixture-failed: %s\n' "$1" >&2; exit 1; }
[ "$(cat /sys/fs/cgroup/memory.max)" = "1610612736" ] || fail memory-limit
[ "$(cat /sys/fs/cgroup/memory.swap.max)" = "0" ] || fail swap-limit
[ "$(cat /sys/fs/cgroup/cpu.max)" = "200000 100000" ] || fail cpu-limit
[ "$(cat /sys/fs/cgroup/pids.max)" = "32" ] || fail pids-limit
[ "$(ulimit -n)" = "64" ] || fail nofile-limit
grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/self/status || fail capabilities
tmpfs_options=$(awk '$2 == "/tmp" && $3 == "tmpfs" { print $4 }' /proc/mounts)
[ -n "$tmpfs_options" ] || fail tmpfs-missing
case "$tmpfs_options" in *noexec*) fail tmpfs-noexec ;; esac
case "$tmpfs_options" in *size=131072k*|*size=134217728*) ;; *) fail tmpfs-size ;; esac
case "$tmpfs_options" in *nr_inodes=4096*) ;; *) fail tmpfs-inode-limit ;; esac
printf '#!/bin/sh\nexit 0\n' > /tmp/exec-probe
chmod 700 /tmp/exec-probe
/tmp/exec-probe || fail tmpfs-exec
[ ! -e /var/run/docker.sock ] || fail docker-socket
[ ! -w /source/input ] || fail source-readonly
[ -w /output ] || fail output-writable
if ( : > /vision-rootfs-write-test ) 2>/dev/null; then
  fail rootfs-readonly
else
  :
fi

input=""
output=""
for argument in "$@"; do
  case "$argument" in
    /source/input) input="$argument" ;;
    /output/*) output="$argument" ;;
  esac
done
[ "$input" = "/source/input" ] || fail source-argument
[ -n "$output" ] || fail output-argument

mode=$(cat "$input")
if [ "$mode" = "sleep" ]; then
  sleep 30
  exit 0
fi

# Deliberate kernel OOM against this single container's 1.5GiB cgroup, never
# the host. The shell replaces itself so Docker records OOMKilled on the
# container's main process. This runs only in the explicitly opt-in test image.
if [ "$mode" = "oom" ]; then
  exec /bin/bash -c 'x=x; i=0; while [ "$i" -lt 32 ]; do x="${x}${x}"; i=$((i + 1)); done; exit 86'
fi

# Try to exceed this container's 32-PID hard cgroup limit. Nothing runs outside
# the worker; the init process kills remaining sleepers when the script exits.
if [ "$mode" = "pid-limit" ]; then
  /bin/bash -c 'set +e; for ((n=0; n<31; n++)); do sleep 5 & done' &
  while true; do
    blocked=0
    while read -r kind number; do
      if [ "$kind" = "max" ]; then blocked=$number; fi
    done < /sys/fs/cgroup/pids.events
    if [ "$blocked" -gt 0 ]; then
      printf 'HOST_OCI_PID_LIMIT_HIT\n'
      exit 85
    fi
  done
fi

printf 'host-oci-limits-and-mounts-verified\n' > "$output"
printf 'HOST_OCI_BOUNDARY_OK\n'
