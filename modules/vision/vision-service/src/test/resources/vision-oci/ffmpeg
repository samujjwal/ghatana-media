#!/bin/bash
set -eu

fail() { printf 'fixture-failed: %s\n' "$1" >&2; exit 1; }
[ "$(cat /sys/fs/cgroup/memory.max)" = "1610612736" ] || fail memory-limit
[ "$(cat /sys/fs/cgroup/memory.swap.max)" = "0" ] || fail swap-limit
[ "$(cat /sys/fs/cgroup/cpu.max)" = "200000 100000" ] || fail cpu-limit
[ "$(cat /sys/fs/cgroup/pids.max)" = "32" ] || fail pids-limit
[ "$(ulimit -n)" = "64" ] || fail nofile-limit
grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/self/status || fail capabilities
tmpfs_options=$(awk '$2 == "/tmp" && $3 == "tmpfs" { print $4 }' /proc/mounts)
[ -n "$tmpfs_options" ] || fail tmpfs-missing
case "$tmpfs_options" in *noexec*) fail tmpfs-noexec ;; esac
case "$tmpfs_options" in *size=131072k*|*size=134217728*) ;; *) fail tmpfs-size ;; esac
case "$tmpfs_options" in *nr_inodes=4096*) ;; *) fail tmpfs-inode-limit ;; esac
printf '#!/bin/sh\nexit 0\n' > /tmp/exec-probe
chmod 700 /tmp/exec-probe
/tmp/exec-probe || fail tmpfs-exec
[ ! -e /var/run/docker.sock ] || fail docker-socket
[ ! -w /source/input ] || fail source-readonly
[ -w /output ] || fail output-writable
if ( : > /vision-rootfs-write-test ) 2>/dev/null; then
  fail rootfs-readonly
else
  :
fi

input=""
output=""
for argument in "$@"; do
  case "$argument" in
    /source/input) input="$argument" ;;
    /output/*) output="$argument" ;;
  esac
done
[ "$input" = "/source/input" ] || fail source-argument
[ -n "$output" ] || fail output-argument

mode=$(cat "$input")
if [ "$mode" = "sleep" ]; then
  sleep 30
  exit 0
fi

# Deliberate kernel OOM against this single container's 1.5GiB cgroup, never
# the host. The shell replaces itself so Docker records OOMKilled on the
# container's main process. This runs only in the explicitly opt-in test image.
if [ "$mode" = "oom" ]; then
  exec /bin/bash -c 'x=x; i=0; while [ "$i" -lt 32 ]; do x="${x}${x}"; i=$((i + 1)); done; exit 86'
fi

# Exercise the configured two-CPU cgroup from inside this worker. Four busy
# children remain inside this container; finish only after the kernel records
# quota throttling, then stop and reap every child before returning success.
if [ "$mode" = "cpu-quota" ]; then
  before=$(awk '$1 == "nr_throttled" { print $2 }' /sys/fs/cgroup/cpu.stat)
  load_pids=()
  stop_load() {
    for load_pid in "${load_pids[@]}"; do kill "$load_pid" 2>/dev/null || true; done
    for load_pid in "${load_pids[@]}"; do wait "$load_pid" 2>/dev/null || true; done
  }
  for worker in 1 2 3 4; do ( while :; do :; done ) & load_pids+=("$!"); done
  trap stop_load EXIT
  throttled=0
  for attempt in $(seq 1 50); do
    after=$(awk '$1 == "nr_throttled" { print $2 }' /sys/fs/cgroup/cpu.stat)
    if [ "$after" -gt "$before" ]; then throttled=1; break; fi
    sleep 0.1
  done
  stop_load
  trap - EXIT
  [ "$throttled" -eq 1 ] || fail cpu-quota-throttling-not-observed
  printf 'HOST_OCI_CPU_QUOTA_THROTTLED before=%s after=%s\n' "$before" "$after"
fi

# Fill only this worker's bounded 128 MiB /tmp tmpfs. `dd` must receive the
# kernel's no-space rejection, after which the partial scratch file is removed
# before the worker exits unsuccessfully. No host path is writable here.
if [ "$mode" = "tmpfs-full" ]; then
  scratch=/tmp/tmpfs-limit-probe.bin
  if dd if=/dev/zero of="$scratch" bs=1M count=129 status=none; then
    rm -f "$scratch"
    fail tmpfs-limit-not-enforced
  else
    dd_exit=$?
  fi
  bytes_written=$(wc -c < "$scratch")
  [ "$bytes_written" -gt 0 ] || fail tmpfs-probe-wrote-no-data
  printf 'HOST_OCI_TMPFS_ENOSPC bytes=%s dd_exit=%s\n' "$bytes_written" "$dd_exit"
  rm -f "$scratch"
  [ ! -e "$scratch" ] || fail tmpfs-probe-cleanup-failed
  exit 88
fi

# Open descriptors only inside this worker until Bash reports the kernel's
# EMFILE condition. Close every descriptor before emitting the sentinel or
# returning to the normal success path.
if [ "$mode" = "nofile" ]; then
  open_fds=()
  emfile=0
  while :; do
    if exec {fd}<>/dev/null; then
      open_fds+=("$fd")
    else
      emfile=1
      break
    fi
  done
  [ "$emfile" -eq 1 ] || fail nofile-limit-not-enforced
  fd_count=${#open_fds[@]}
  for descriptor in "${open_fds[@]}"; do exec {descriptor}>&-; done
  [ "$fd_count" -gt 50 ] || fail nofile-open-count-too-low
  printf 'HOST_OCI_NOFILE_EMFILE descriptors=%s\n' "$fd_count"
fi

# Attempt a single output-mount file larger than the request's existing
# RLIMIT_FSIZE. Confirm the worker is interrupted at the kernel boundary and
# exit unsuccessfully, leaving only the kernel-capped partial file for the
# caller to reject. The test fixture removes it after checking the result.
if [ "$mode" = "filesize" ]; then
  if dd if=/dev/zero of="$output" bs=1M count=4 status=none; then
    fail output-file-size-limit-not-enforced
  else
    dd_exit=$?
  fi
  bytes_written=$(wc -c < "$output")
  [ "$bytes_written" -gt 0 ] || fail output-file-size-probe-wrote-no-data
  printf 'HOST_OCI_FILESIZE_LIMIT_HIT bytes=%s dd_exit=%s\n' "$bytes_written" "$dd_exit"
  exit 89
fi

# Try to exceed this container's 32-PID hard cgroup limit. Nothing runs outside
# the worker; the init process kills remaining sleepers when the script exits.
if [ "$mode" = "pid-limit" ]; then
  /bin/bash -c 'set +e; for ((n=0; n<31; n++)); do sleep 5 & done' &
  while true; do
    blocked=0
    while read -r kind number; do
      if [ "$kind" = "max" ]; then blocked=$number; fi
    done < /sys/fs/cgroup/pids.events
    if [ "$blocked" -gt 0 ]; then
      printf 'HOST_OCI_PID_LIMIT_HIT\n'
      exit 85
    fi
  done
fi

printf 'host-oci-limits-and-mounts-verified\n' > "$output"
printf 'HOST_OCI_BOUNDARY_OK\n'
