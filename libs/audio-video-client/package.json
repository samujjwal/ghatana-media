{
  "name": "@audio-video/client",
  "version": "0.1.0-SNAPSHOT",
  "description": "Operation-oriented TypeScript client for governed media artifacts and processing jobs",
  "bin": {
    "ghatanamedia-api": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/ensure-cli-executable.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js"
    },
    "./canonical-routes": {
      "types": "./dist/canonical-routes.d.ts",
      "import": "./dist/canonical-routes.js"
    }
  },
  "dependencies": {
    "@audio-video/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samujjwal/ghatana-media.git",
    "directory": "libs/audio-video-client"
  },
  "keywords": [
    "client",
    "operations",
    "audio",
    "video",
    "multimodal",
    "ghatana"
  ],
  "author": "Ghatana Team",
  "license": "MIT"
}
