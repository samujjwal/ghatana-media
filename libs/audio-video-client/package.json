{
  "name": "@audio-video/client",
  "version": "0.1.0-SNAPSHOT",
  "description": "Operation-oriented TypeScript client for governed media artifacts and processing jobs",
  "bin": {
    "ghatanamedia-api": "./dist/cli.js",
    "ghatanamedia-api-dev": "./dist/cli-dev.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @audio-video/types build && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/copy-cjs-package.mjs && node scripts/ensure-cli-executable.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "node scripts/clean.mjs",
    "test": "pnpm build && vitest run",
    "test:package": "pnpm build && node scripts/test-isolated-package-consumer.mjs",
    "test:package:consumer": "node scripts/test-isolated-package-consumer.mjs",
    "test:browser:offline-store": "pnpm build && node scripts/test-indexeddb-offline-edit-store-browser.mjs",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js",
      "require": "./dist-cjs/operations.js"
    },
    "./canonical-routes": {
      "types": "./dist/canonical-routes.d.ts",
      "import": "./dist/canonical-routes.js",
      "require": "./dist-cjs/canonical-routes.js"
    },
    "./canonical-operations": {
      "types": "./dist/canonical-operations.d.ts",
      "import": "./dist/canonical-operations.js",
      "require": "./dist-cjs/canonical-operations.js"
    },
    "./http-core": {
      "types": "./dist/http-core.d.ts",
      "import": "./dist/http-core.js",
      "require": "./dist-cjs/http-core.js"
    },
    "./capture-adapters": {
      "types": "./dist/capture-adapters.d.ts",
      "import": "./dist/capture-adapters.js",
      "require": "./dist-cjs/capture-adapters.js"
    },
    "./http-capture-adapter": {
      "types": "./dist/http-capture-adapter.d.ts",
      "import": "./dist/http-capture-adapter.js",
      "require": "./dist-cjs/http-capture-adapter.js"
    },
    "./file-capture-adapter": {
      "types": "./dist/file-capture-adapter.d.ts",
      "import": "./dist/file-capture-adapter.js",
      "require": "./dist-cjs/file-capture-adapter.js"
    },
    "./camera-capture-adapter": {
      "types": "./dist/camera-capture-adapter.d.ts",
      "import": "./dist/camera-capture-adapter.js",
      "require": "./dist-cjs/camera-capture-adapter.js"
    },
    "./recorder-orchestrator": {
      "types": "./dist/recorder-orchestrator.d.ts",
      "import": "./dist/recorder-orchestrator.js",
      "require": "./dist-cjs/recorder-orchestrator.js"
    },
    "./production-plan": {
      "types": "./dist/production-plan.d.ts",
      "import": "./dist/production-plan.js",
      "require": "./dist-cjs/production-plan.js"
    },
    "./offline-edit-queue": {
      "types": "./dist/offline-edit-queue.d.ts",
      "import": "./dist/offline-edit-queue.js",
      "require": "./dist-cjs/offline-edit-queue.js"
    },
    "./offline-edit-store": {
      "types": "./dist/indexeddb-offline-edit-store.d.ts",
      "import": "./dist/indexeddb-offline-edit-store.js",
      "require": "./dist-cjs/indexeddb-offline-edit-store.js"
    },
    "./offline-reconnect": {
      "types": "./dist/offline-reconnect.d.ts",
      "import": "./dist/offline-reconnect.js",
      "require": "./dist-cjs/offline-reconnect.js"
    },
    "./caption-version": {
      "types": "./dist/caption-version.d.ts",
      "import": "./dist/caption-version.js",
      "require": "./dist-cjs/caption-version.js"
    },
    "./dev-project-timeline": {
      "types": "./dist/dev-project-timeline.d.ts",
      "import": "./dist/dev-project-timeline.js",
      "require": "./dist-cjs/dev-project-timeline.js"
    },
    "./dev-job-cancellation": {
      "types": "./dist/dev-job-cancellation.d.ts",
      "import": "./dist/dev-job-cancellation.js",
      "require": "./dist-cjs/dev-job-cancellation.js"
    }
  },
  "dependencies": {
    "@audio-video/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samujjwal/ghatana-media.git",
    "directory": "libs/audio-video-client"
  },
  "keywords": [
    "client",
    "operations",
    "audio",
    "video",
    "multimodal",
    "ghatana"
  ],
  "author": "Ghatana Team",
  "license": "MIT"
}
