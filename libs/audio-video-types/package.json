{
  "name": "@audio-video/types",
  "version": "0.1.0-SNAPSHOT",
  "description": "Canonical TypeScript contracts for media artifacts, jobs, providers, and audio-video operations",
  "main": "dist-cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/copy-cjs-package.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run && node scripts/protocol-projection-parity.mjs",
    "test:projection-parity": "node scripts/protocol-projection-parity.mjs",
    "test:package": "pnpm build && node scripts/check-emitted-contract-parity.mjs && node scripts/test-isolated-package-consumer.mjs",
    "test:package:consumer": "node scripts/test-isolated-package-consumer.mjs",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm test:package"
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist-cjs/contracts.js"
    },
    "./production": {
      "types": "./dist/production.d.ts",
      "import": "./dist/production.js",
      "require": "./dist-cjs/production.js"
    }
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samujjwal/ghatana-media.git",
    "directory": "libs/audio-video-types"
  },
  "keywords": [
    "typescript",
    "contracts",
    "audio",
    "video",
    "multimodal",
    "ghatana"
  ],
  "author": "Ghatana Team",
  "license": "MIT"
}
