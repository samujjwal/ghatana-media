{
  "name": "@ghatana/media-experience-simulation",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "description": "Deterministic Media workflow fixtures and command simulation; not a runtime client or generic Explorer host",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "media-experience-fixture": "./bin/media-experience-fixture.mjs",
    "media-experience-command-simulator": "./bin/media-experience-command-simulator.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @audio-video/client build && pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ghatana/experience-package": "0.1.0-SNAPSHOT"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "yaml": "2.9.1"
  }
}
