# Media vision-service — development candidate, NOT a qualified release image.
# Prerequisite: run ./gradlew :services:media:modules:vision:vision-service:installDist
# in the approved source-composite toolchain. Run docker build -f docker/Dockerfile.vision-service .
# This stage consumes ONLY the verified Gradle application distribution from the
# active build tree; it never builds from obsolete products/audio-video paths.
# Build/published-image digest, license/SBOM and environment admission are separate.
FROM eclipse-temurin:21-jre-jammy
RUN groupadd --gid 10001 media && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin media
WORKDIR /app
COPY --chown=10001:10001 modules/vision/vision-service/build/install/vision-service/ /app/
ENV VISION_GRPC_PORT=50054
USER 10001:10001
EXPOSE 50054
ENTRYPOINT ["/app/bin/vision-service"]
