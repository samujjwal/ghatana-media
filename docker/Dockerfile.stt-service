# Media stt-service — development candidate, NOT a qualified release image.
# Prerequisite: run ./gradlew :services:media:modules:speech:stt-service:installDist
# in the approved source-composite toolchain. Run docker build -f docker/Dockerfile.stt-service .
# This stage consumes ONLY the verified Gradle application distribution from the
# active build tree; it never builds from obsolete products/audio-video paths.
# Build/published-image digest, license/SBOM and environment admission are separate.
FROM eclipse-temurin:27-jre
RUN groupadd --gid 10001 media && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin media
WORKDIR /app
COPY --chown=10001:10001 modules/speech/stt-service/build/install/stt-service/ /app/
ENV STT_GRPC_PORT=50051 \
    AV_HEALTH_PORT=8090
USER 10001:10001
EXPOSE 50051 8090
ENTRYPOINT ["/app/bin/stt-service"]
