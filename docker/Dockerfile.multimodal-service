# Media multimodal-service — development candidate, NOT a qualified release image.
# Prerequisite: run ./gradlew :services:media:modules:intelligence:multimodal-service:installDist
# in the approved source-composite toolchain. Run docker build -f docker/Dockerfile.multimodal-service .
# This stage consumes ONLY the verified Gradle application distribution from the
# active build tree; it never builds from obsolete products/audio-video paths.
# Build/published-image digest, license/SBOM and environment admission are separate.
FROM eclipse-temurin:27-jre
RUN groupadd --gid 10001 media && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin media
WORKDIR /app
COPY --chown=10001:10001 modules/intelligence/multimodal-service/build/install/multimodal-service/ /app/
ENV MULTIMODAL_GRPC_PORT=50055 \
    AV_HEALTH_PORT=8093
USER 10001:10001
EXPOSE 50055 8093
ENTRYPOINT ["/app/bin/multimodal-service"]
