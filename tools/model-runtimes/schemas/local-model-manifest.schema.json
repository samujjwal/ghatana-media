{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ghatana:media:schema:local-model-manifest:v1",
  "title": "Ghatana Media local model manifest",
  "description": "Lives next to model weights OUTSIDE the repository as ghatana-model-manifest.json. A model is QUALIFIED only when every listed file's on-disk SHA-256 equals this manifest and the SPDX id is the one the owner decision names.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelId", "role", "sourceUrl", "revision", "spdxLicense", "licenseFile", "files", "fileSetSha256", "remoteCode", "runtime", "ownerDecision", "attribution", "obligations"],
  "properties": {
    "schemaVersion": {"const": "ghatana.media.local-model-manifest.v1"},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 200},
    "role": {"enum": ["VISION", "MULTIMODAL_QA", "SPEECH_TO_TEXT", "TEXT_TO_SPEECH"]},
    "sourceUrl": {"type": "string", "format": "uri"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "spdxLicense": {"enum": ["MIT", "Apache-2.0"]},
    "licenseFile": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "source"],
      "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "source": {"type": "string"}}
    },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256", "sizeBytes"],
        "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9._-][A-Za-z0-9._/-]*$"},
                       "sha256": {"$ref": "#/$defs/sha256"}, "sizeBytes": {"type": "integer", "minimum": 0},
                       "upstreamSha256Verified": {"type": "boolean"}}
      }
    },
    "fileSetSha256": {"$ref": "#/$defs/sha256"},
    "remoteCode": {
      "type": "object", "additionalProperties": false, "required": ["required", "files"],
      "properties": {"required": {"type": "boolean"}, "pinnedRevision": {"type": ["string", "null"]},
                     "files": {"type": "array", "items": {"type": "string"}}}
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["kind", "quantization"],
      "properties": {"kind": {"type": "string"}, "quantization": {"type": "string"}}
    },
    "ownerDecision": {
      "type": "object", "additionalProperties": false, "required": ["quote", "decidedOn", "channel"],
      "properties": {"quote": {"type": "string"}, "licenseNote": {"type": "string"},
                     "decidedOn": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "channel": {"type": "string"}}
    },
    "attribution": {"type": "string"},
    "obligations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
